# Supabase (Projekt-Einstellungen → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Welcher Zahlungsanbieter aktiv ist: "micropayment" (Standard) oder "stripe".
# Siehe lib/payments/index.ts.
PAYMENT_PROVIDER=micropayment

# micropayment.ch — Feldnamen vorläufig, werden beim Ausfüllen von
# lib/payments/micropayment.ts final festgelegt (siehe TODO(MP) dort).
MICROPAYMENT_PROJECT_ID=
MICROPAYMENT_ACCESS_KEY=
MICROPAYMENT_SECRET=

# Stripe — aktuell geparkt, Code bleibt lauffähig (Dashboard → Developers → API keys / Webhooks)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Basis-URL der App (lokal http://localhost:3000, produktiv die echte Domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
